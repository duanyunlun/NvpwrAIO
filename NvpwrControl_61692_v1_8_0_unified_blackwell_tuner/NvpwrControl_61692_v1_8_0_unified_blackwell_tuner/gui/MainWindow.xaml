<Window x:Class="NvpwrControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NvpwrControl"
        Title="NV显卡功耗软解"
        Width="873" Height="756"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#10131A"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <!--
        Three cards side by side, then everything else as buttons.

          功耗 | 电压 | 频率

        The window is a fixed 1280x720 client area (ResizeMode NoResize; the outer size is the
        client size plus the 13x36 frame Windows draws). Content is laid out for exactly that
        many pixels, so nothing scrolls and nothing is clipped.

        Each card shows its own readings as value-over-caption pairs, so a card answers its own
        question without the reader having to look elsewhere on screen.

        Voltage offers both routes to the rail, because they are different controls:
          · 最低/最高电压    absolute limits across the device range 445-1280 mV; these drive
                             the VMIN and REL offsets
          · 核心 / XBar 偏移   demand offsets, -25…+50 mV; these request a voltage rather than
                             bounding one
        Every one is a draggable slider — this card has no stepper buttons.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Rail"        Color="#161A23"/>
        <SolidColorBrush x:Key="CardBg"      Color="#1B202B"/>
        <SolidColorBrush x:Key="CardBorder"  Color="#2D3546"/>
        <SolidColorBrush x:Key="NoteBg"      Color="#151922"/>
        <SolidColorBrush x:Key="FieldBg"     Color="#232936"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#39435A"/>
        <SolidColorBrush x:Key="TextMain"    Color="#EDF2F7"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextDim"     Color="#64748B"/>
        <SolidColorBrush x:Key="Accent"      Color="#76B900"/>
        <SolidColorBrush x:Key="Info"        Color="#38BDF8"/>
        <SolidColorBrush x:Key="Warn"        Color="#FBBF24"/>
        <SolidColorBrush x:Key="Danger"      Color="#EF6461"/>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            The value line of a card reading. All nine readings across the three cards share it,
            so they sit on one baseline and their captions line up. Sizing one of them separately
            to make it fit (which an earlier version did) left it visibly smaller than its
            neighbours and pushed its caption out of line with theirs.
        -->
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--
            The value line of a card reading. Every reading in a card uses this, so the three sit
            on one baseline and their captions line up. An earlier version overrode the font size
            on a single reading to make it fit, which left it visibly smaller than its neighbours
            and pushed its caption out of line with theirs.
        -->
        <Style x:Key="ReadingValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="BigSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Width" Value="66"/>
        </Style>

        <!--
            The power target keeps the weight it had as a readout — it is the number the whole
            card is about — but is a field now.

            Sized to what it holds and no more. Three digits at this weight need about 44 DIP
            with padding; 66 was carried over from the readout, which had no reason to be
            narrow, and the extra width plus a roomy wrapper pushed 复位 和 应用 off the right
            edge of a fixed-width card.
        -->
        <Style x:Key="PowerInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#3E4C63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0C1408"/>
            <Setter Property="BorderBrush" Value="#8FD400"/>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#462026"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="#6E323A"/>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        </Style>

        <Style x:Key="Step" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#232936"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="13,12"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="NotePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NoteBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== header ===== -->
        <Border Grid.Row="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                        The window title already carries the program name, so the heading here is
                        used for the thing a reader needs to check before trusting anything below
                        it: the driver build. That is the one hard requirement this program has,
                        and it cannot be worked around — the kernel helper reads and writes the
                        power policy at offsets taken from the 616.92 internal layout, so another
                        build would have it writing into whatever sits at those offsets.
                    -->
                    <TextBlock Text="驱动" FontSize="12" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="DriverText" Text="—" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SubtitleText" Text="" FontSize="12"
                               Foreground="{StaticResource TextMuted}" Margin="14,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!--
                    The one thing that has to be said somewhere.

                    Each card used to carry a 注意 panel. Two of them restated what the controls
                    beside them already showed, and the third — that the power ceiling lives only
                    in driver memory and is gone after a reboot — is a property of the whole
                    program rather than of any one card, so it belongs up here where it covers all
                    of them.
                -->
                <TextBlock x:Name="HeaderHint" Grid.Column="1" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontSize="11.5"
                           Foreground="{StaticResource TextDim}"
                           Text="功耗上限只写在驱动内存里，重启必然失效 —— 需要常驻请点右下角「安装服务」"/>
            </Grid>
        </Border>

        <!-- ===================== two cards ===================== -->
        <Grid Grid.Row="1" Margin="14,12,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 功耗 ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="3" CornerRadius="2" Margin="0,1,8,1"
                                        Background="{StaticResource Accent}"/>
                                <TextBlock Text="功耗" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="出厂功耗墙" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PwFloorLabel" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource Accent}" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="5,0,0,0" Text="—"/>
                            </StackPanel>
                        </Grid>

                        <!--
                            A Grid with fixed column widths rather than a horizontal StackPanel.

                            Stacked panels size to whatever they contain, so the readings shifted
                            sideways every time a number changed width — 982 MHz and 1005 MHz are
                            not the same width, and everything to their right moved with them. The
                            columns here are sized for the widest reading each one can hold.
                        -->
                        <Grid Margin="0,16,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124"/>
                                <ColumnDefinition Width="124"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="PwNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="当前功耗" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PwLimitNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="当前上限" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <!-- Temperature lives here now: it belongs with power, since the two
                                 together decide whether a raised ceiling can actually be used. -->
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="PwTemp" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="核心温度" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!--
                            Read left to right as a range: what the card defaults to, the stepper
                            that moves the target, and the ceiling it can be moved to. The floor
                            and ceiling sit on the sides the stepper can actually reach them from,
                            so the row reads as a scale rather than a value followed by a note.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock x:Name="PwFloorRef" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,7,0" Text="—"/>
                            <Button x:Name="PwMinus" Content="−" Style="{StaticResource Step}"
                                    Click="OnPowerMinus"/>
                            <!--
                                Typed, not only stepped. 25 W at a time is fine for finding a
                                ceiling and useless for the last few watts, which is what tuning
                                actually needs.

                                The wrapper is only as wide as the field plus its unit, and the
                                two are centred inside it. An earlier 116 DIP wrapper gave the
                                group generous margins on both sides, which looked balanced on its
                                own and cost enough width that 复位 and 应用 were pushed past the
                                right edge of the card.
                            -->
                            <Grid Width="84" Margin="2,0,2,0">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBox x:Name="PwTargetNow" Style="{StaticResource PowerInput}"
                                             PreviewTextInput="OnClockIntegerOnly"
                                             KeyDown="OnPowerTargetKey"
                                             LostFocus="OnPowerTargetCommit"/>
                                    <TextBlock Text="W" Style="{StaticResource BigNumber}" FontSize="20"
                                               Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                                               Margin="2,0,0,0" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="PwPlus" Content="+" Style="{StaticResource Step}" Click="OnPowerPlus"/>
                            <TextBlock x:Name="PwMaxLabel" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource Danger}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="3,0,0,0" Text="—"/>
                            <Button Content="复位" Style="{StaticResource BtnDanger}" Padding="10,7"
                                    Margin="10,0,7,0" Click="OnPowerReset"/>
                            <Button Content="应用" Style="{StaticResource BtnPrimary}" MinWidth="48"
                                    Padding="9,7" Margin="0" Click="OnApplyPower"/>
                        </StackPanel>

                        <TextBlock x:Name="PwHint" Style="{StaticResource Caption}" Margin="0,10,0,0"/>

                        <!-- Frequency moved into this card. It has the same readouts and the same
                             stepper row shape, and a card of its own held four controls with a lot
                             of empty space below them. -->
                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0"/>

                        <!-- The frequency block below the divider gets a heading of its own, in
                             the same shape as the one at the top of the card, so the card reads
                             as two sections rather than one list that changes subject. -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Width="3" CornerRadius="2" Margin="0,1,8,1"
                                    Background="{StaticResource Warn}"/>
                            <TextBlock Text="频率" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <!--
                            Fixed columns for the same reason as the power card's readings: the two
                            clock values change width as they change value, and everything to their
                            right used to move with them. Sized for the widest each can show —
                            1995 MHz for core, 14001 MHz for memory — with the share-of-load
                            column left to size itself, since it tops out at 100 %.
                        -->
                        <Grid Margin="0,12,0,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124"/>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="ClkNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="核心频率" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="MemNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="显存时钟" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="UtilNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="占用率" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!--
                            Same shape as the power card's control row: the low end of the range on the
                            left, the value being set in the middle, the high end on the right, and a
                            stepper either side. The middle is editable here rather than a readout,
                            because a clock offset is a number people usually know before they start
                            and stepping to it 50 MHz at a time would be tedious.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBlock Text="核心" Style="{StaticResource RowLabel}" Width="38"/>
                            <TextBlock x:Name="ClkCoreMinLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" Text="—"/>
                            <Button Content="−" Style="{StaticResource Step}" Click="OnClkCoreMinus"/>
                            <TextBox x:Name="ClkCore" Style="{StaticResource Input}" Width="58"
                                     PreviewTextInput="OnClockIntegerOnly"/>
                            <Button Content="+" Style="{StaticResource Step}" Margin="6,0,6,0"
                                    Click="OnClkCorePlus"/>
                            <TextBlock x:Name="ClkCoreMaxLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Text="—"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="显存" Style="{StaticResource RowLabel}" Width="38"/>
                            <TextBlock x:Name="ClkMemMinLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" Text="—"/>
                            <Button Content="−" Style="{StaticResource Step}" Click="OnClkMemMinus"/>
                            <TextBox x:Name="ClkMem" Style="{StaticResource Input}" Width="58"
                                     PreviewTextInput="OnClockIntegerOnly"/>
                            <Button Content="+" Style="{StaticResource Step}" Margin="6,0,6,0"
                                    Click="OnClkMemPlus"/>
                            <TextBlock x:Name="ClkMemMaxLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Text="—"/>
                        </StackPanel>

                        <StackPanel x:Name="ClkXbarRow" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="XBar" Style="{StaticResource RowLabel}" Width="38"
                                       ToolTip="GPU 内部把核心和显存连起来的交换网络，进出显存的数据都经过它。"/>
                            <TextBlock x:Name="ClkXbarMinLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" Text="—"/>
                            <Button Content="−" Style="{StaticResource Step}" Click="OnClkXbarMinus"/>
                            <TextBox x:Name="ClkXbar" Style="{StaticResource Input}" Width="58"
                                     PreviewTextInput="OnClockIntegerOnly"/>
                            <Button Content="+" Style="{StaticResource Step}" Margin="6,0,6,0"
                                    Click="OnClkXbarPlus"/>
                            <TextBlock x:Name="ClkXbarMaxLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Text="—"/>
                            <!--
                                Only this row carries a note. Core and memory stand on their own; the
                                crossbar does not, and the question it raises — what is this, and why
                                would I touch it — is better answered here than in a tooltip nobody
                                hovers over.
                            -->
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="核心-显存的交换网络"
                                       ToolTip="XBar 是 GPU 内部把核心和显存连起来的交换网络，进出显存的数据都经过它。&#10;对显存敏感的场景（高分辨率、大纹理）提速可能有效；纯计算场景收益很小。&#10;调高后若出现花屏或驱动重置，回退频率，或在电压卡片里把 MSVDD 的最低电压抬高一点。"/>
                        </StackPanel>

                        <!-- SYS —— 系统/主机接口域的时钟。
                             和 XBar 一样属于 GPU 内部的总线域而非核心，所以单独一行。 -->
                        <StackPanel x:Name="ClkSysRow" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="SYS" Style="{StaticResource RowLabel}" Width="38"
                                       ToolTip="系统/宿主接口域的时钟，负责 GPU 与主机之间的通路。"/>
                            <TextBlock x:Name="ClkSysMinLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" Text="—"/>
                            <Button Content="−" Style="{StaticResource Step}" Click="OnClkSysMinus"/>
                            <TextBox x:Name="ClkSys" Style="{StaticResource Input}" Width="58"
                                     PreviewTextInput="OnClockIntegerOnly"/>
                            <Button Content="+" Style="{StaticResource Step}" Margin="6,0,6,0"
                                    Click="OnClkSysPlus"/>
                            <TextBlock x:Name="ClkSysMaxLabel" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Text="—"/>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="主机接口时钟"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="重置" Style="{StaticResource BtnDanger}" Padding="10,7"
                                    Margin="0,0,7,0" Click="OnResetClocks"/>
                            <Button Content="应用" Style="{StaticResource BtnPrimary}" MinWidth="48"
                                    Padding="9,7" Margin="0" Click="OnApplyClocks"/>
                        </StackPanel>

                        <!-- BoostLock 独占卡片底部，和上面的调整控件隔开。

                             它不是"改一个数值再应用"，而是一个开关：按一下当场改变 GPU 的
                             加速行为，没有「应用」这一步。所以它不该挤在 重置/应用 旁边 ——
                             伸手去点「应用」时很容易误触。隔一条分割线、做满宽度、字大一号，
                             既不容易点错，也一眼能看出这张卡还有一个总开关。 -->
                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,18,0,0"/>

                        <Button x:Name="BoostLockButton" Content="锁定超频"
                                Style="{StaticResource Btn}"
                                FontSize="15" FontWeight="SemiBold" Padding="0,17"
                                HorizontalAlignment="Stretch" Margin="0,16,0,0"
                                Click="OnToggleBoostLock"/>
                        <TextBlock x:Name="BoostLockState" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMuted}" Text="—"/>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ===== 电压 ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="3" CornerRadius="2" Margin="0,1,8,1"
                                        Background="{StaticResource Info}"/>
                                <TextBlock Text="电压" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                        </Grid>

                        <!--
                            两条轨各一行实时读数，并排放在卡片顶部。

                            原来只有 NVVDD 一行，中间那格是“已应用偏移”。那一格去掉了：
                            它显示的是需求偏移（通常为 0），而那个偏移已经没有可调控件了，且真正想知道的
                            “驱动现在把电压限制在哪”已经由右格给出。MSVDD 补上同样的一行，两条轨就能对着看。
                        -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,22,0">
                                <TextBlock x:Name="VoltNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource Info}" Text="—"/>
                                <TextBlock Text="核心电压" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock x:Name="VoltLimitsNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="当前上下限" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,22,0">
                                <TextBlock x:Name="MsvddVoltNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource Warn}" Text="—"/>
                                <TextBlock Text="MSVDD 电压" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                <TextBlock x:Name="MsvddLimitsNow" Style="{StaticResource BigNumber}"
                                           Foreground="{StaticResource TextMain}" Text="—"/>
                                <TextBlock Text="当前上下限" Style="{StaticResource BigSub}"
                                           Foreground="{StaticResource TextDim}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- NVVDD —— 核心供电轨。
                             上下限合成一个双滑块控件，而不是两个独立滑块：它们本来就是同一个
                             量的两端，mVolt+ 也是这么呈现的，一个控件直接读出「825–1025 mV」
                             比两个滑块加一个公式框去暗示这层关系清楚得多。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Border Width="3" CornerRadius="2" Margin="0,1,8,1"
                                    Background="{StaticResource Info}"/>
                            <TextBlock Text="NVVDD" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="核心本体供电 · 抬高最低电压可防止满载掉压，是提分主力"
                                       ToolTip="NVVDD 是 GPU 核心（SM / 着色器 / 纹理单元）的供电轨，也是唯一用户可调的那一条。&#10;典型 0.6–1.0 V，功耗占比最大。&#10;抬高它的最低电压能防止满载时电压塌陷，让核心更稳地维持高频 —— 实测这是提升分数最有效的一项。"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" TextTrimming="CharacterEllipsis"
                                       Text="工作电压范围 · 最小 / 最大"
                                       ToolTip="两端分别对应驱动的 VMIN 与 REL/ALT 偏移。&#10;左端是最低工作电压，抬高它能防止满载时电压塌陷，是提升分数的主要手段。&#10;右端是最高工作电压，压低它才是传统意义的降压。&#10;器件允许区间 445–1280 mV。"/>
                            <TextBlock Grid.Column="1" x:Name="NvvddRangeLabel" Style="{StaticResource BigSub}"
                                       Foreground="{StaticResource Info}" FontWeight="SemiBold" Text="— mV"/>
                        </Grid>
                        <local:RangeSlider x:Name="NvvddRange" Minimum="445" Maximum="1150"
                                     LowerValue="625" UpperValue="1025" TickFrequency="5"
                                     Margin="0,4,0,0" RangeChanged="OnNvvddRangeChanged"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="NvvddLowerLabel" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextMuted}" Text="下限 —"/>
                            <TextBlock Grid.Column="1" x:Name="NvvddUpperLabel" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextMuted}" Text="上限 —"/>
                        </Grid>


                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0"/>

                        <!-- MSVDD —— 和 NVVDD 并列的另一条轨。
                             供 XBar、L2 和内存接口，有独立的电压和功率遥测。
                             XBar 时钟就跑在这个域上，所以下面的 XBar 电压请求和这里的上下限
                             说的是同一件事的两条路径。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Width="3" CornerRadius="2" Margin="0,1,8,1"
                                    Background="{StaticResource Warn}"/>
                            <TextBlock Text="MSVDD" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="XBar / L2 / 内存接口供电 · XBar 时钟跑在这个域上"
                                       ToolTip="MSVDD 是核心与显存之间那部分电路的供电轨：XBar、L2 缓存和内存接口。&#10;它和 NVVDD 是物理上分开的两条轨，各有独立的电压和功率遥测。&#10;GPU 内部的 XBar 时钟就跑在这个域上 —— 所以这里的上下限直接决定 XBar 能跑多高。"/>
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" TextTrimming="CharacterEllipsis"
                                       Text="工作电压范围 · 最小 / 最大"
                                       ToolTip="MSVDD 轨的最低与最高工作电压，对应驱动的 VMIN 与 REL/ALT 偏移。&#10;MSVDD 给XBar、L2 和内存接口供电，和供核心的 NVVDD 是两条独立的轨。&#10;器件允许区间 445–1280 mV。"/>
                            <TextBlock Grid.Column="1" x:Name="MsvddRangeLabel" Style="{StaticResource BigSub}"
                                       Foreground="{StaticResource Warn}" FontWeight="SemiBold" Text="— mV"/>
                        </Grid>
                        <local:RangeSlider x:Name="MsvddRange" Minimum="445" Maximum="1150"
                                     LowerValue="655" UpperValue="1025" TickFrequency="5"
                                     Margin="0,4,0,0" RangeChanged="OnMsvddRangeChanged"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MsvddLowerLabel" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextMuted}" Text="下限 —"/>
                            <TextBlock Grid.Column="1" x:Name="MsvddUpperLabel" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextMuted}" Text="上限 —"/>
                        </Grid>


                        <!-- 清零/应用 act on the whole card, so they stay together on the left;
                             打开 mVolt+ is a way out to another program and sits apart on the
                             right, where it cannot be hit by mistake while reaching for 应用. -->
                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="清零" Style="{StaticResource BtnDanger}" Padding="10,7"
                                        Margin="0,0,7,0" Click="OnVoltReset"/>
                                <Button Content="应用" Style="{StaticResource BtnPrimary}" MinWidth="48"
                                        Padding="9,7" Margin="0" Click="OnApplyVoltage"/>
                            </StackPanel>
                            <Button Content="打开 mVolt+" Style="{StaticResource BtnGhost}"
                                    HorizontalAlignment="Right" Click="OnOpenMVoltFull"/>
                        </Grid>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

        <!-- ===== bottom bar: prerequisites, actions ===== -->
        <Border Grid.Row="2" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="18,8">
            <StackPanel>
                <WrapPanel x:Name="PreHost" Margin="0,0,0,7"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ActionHint" Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="Wrap" FontSize="11.5"
                               Foreground="{StaticResource TextDim}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="撤销" Style="{StaticResource Btn}" Click="OnUndo"/>
                        <Button Content="恢复默认" Style="{StaticResource BtnDanger}" Click="OnRestoreDefaults"/>
                        <Button Content="保存配置" Style="{StaticResource Btn}" Click="OnOpenSlots"/>
                        <Button Content="一键应用全部" Style="{StaticResource BtnPrimary}" Click="OnApplyAll"/>
                        <Button x:Name="ServiceButton" Content="安装服务" Style="{StaticResource Btn}"
                                Margin="0" Click="OnToggleService"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</Window>