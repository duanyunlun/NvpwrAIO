<Window x:Class="NvpwrControl.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NV显卡功耗软解"
        Width="500"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <!--
        A themed replacement for MessageBox.

        MessageBox was drawn by Windows in its own light chrome, which sat badly
        against everything else here — and at 200% scaling it sized itself from the
        unwrapped text, so a long warning pushed the dialog past the edge of the
        window and cut its buttons off. This one wraps, scrolls if it has to, and
        follows the companion tool's house style.

        That style is flat: a near-black panel, a hairline border, and one blue
        accent. The shadow is deliberately faint — enough to lift the panel off the
        window behind it, not enough to read as a raised card, which is a look the
        companion tool does not use anywhere.

        The window itself is transparent and the panel carries the margin, the
        rounded corners and the shadow; a window with system chrome cannot be
        rounded, and AllowsTransparency is what lets the shadow fall outside the
        border. It costs ClearType — Windows will not do subpixel text on a
        transparent surface — so rendering is set to Grayscale explicitly rather
        than left on ClearType, which would silently look wrong.
    -->

    <Window.Resources>
        <!-- Palette lifted from the companion tool: #0E1014 shell, #16181D panels,
             #262A33 hairlines, #4FC3F7 accent. -->
        <SolidColorBrush x:Key="PanelBg"    Color="#16181D"/>
        <SolidColorBrush x:Key="PanelEdge"  Color="#262A33"/>
        <SolidColorBrush x:Key="HeadingFg"  Color="#E8EAED"/>
        <SolidColorBrush x:Key="BodyFg"     Color="#B6BCC6"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="BtnBg"      Color="#1E2128"/>
        <SolidColorBrush x:Key="BtnEdge"    Color="#2F343D"/>
        <SolidColorBrush x:Key="BtnFg"      Color="#C9CFD8"/>
        <SolidColorBrush x:Key="PrimaryBg"  Color="#2A6E9E"/>
        <SolidColorBrush x:Key="PrimaryEdge" Color="#3A87BC"/>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BtnFg}"/>
            <Setter Property="Background" Value="{StaticResource BtnBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BtnEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252932"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A404B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource PrimaryBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryEdge}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3180B6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7FD4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin is the shadow's room; without it the effect is clipped at the
         window edge and the panel looks flat in the wrong way. -->
    <Border x:Name="RootPanel" Margin="18" CornerRadius="8"
            Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelEdge}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                              Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title strip. There is no system chrome, so this is what the window is
                 dragged by. -->
            <Border Grid.Row="0" Background="#131519" BorderBrush="{StaticResource PanelEdge}"
                    BorderThickness="0,0,0,1" Padding="18,12"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="TitleAccent" Width="3" CornerRadius="2" Margin="0,1,10,1"
                            Background="{StaticResource AccentBlue}"/>
                    <TextBlock x:Name="TitleText" Text="NV显卡功耗软解" FontSize="14"
                               FontWeight="SemiBold" Foreground="{StaticResource HeadingFg}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="18,16,18,4">
                <TextBlock x:Name="MessageText" Foreground="{StaticResource BodyFg}"
                           TextWrapping="Wrap" LineHeight="21"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="18,14,18,16">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource Btn}"
                        Margin="0,0,10,0" IsCancel="True" Click="OnCancel"/>
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource BtnPrimary}"
                        IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
