<Window x:Class="NvpwrControl.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560" Height="600"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#10131A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <!--
        Settings lives in a dialog rather than a section of the main window: it is
        configured once, and the main window's space is better spent on controls
        plus the always-visible status panel.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg"      Color="#1B202B"/>
        <SolidColorBrush x:Key="CardBorder"  Color="#2D3546"/>
        <SolidColorBrush x:Key="FieldBg"     Color="#232936"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#39435A"/>
        <SolidColorBrush x:Key="TextMain"    Color="#EDF2F7"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent"      Color="#76B900"/>
        <SolidColorBrush x:Key="Danger"      Color="#EF6461"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,13,16,15"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#3E4C63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0C1408"/>
            <Setter Property="BorderBrush" Value="#8FD400"/>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#462026"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="#6E323A"/>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,16">
        <StackPanel>

            <!-- startup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="启动" Style="{StaticResource CardTitle}"/>
                    <CheckBox x:Name="ChkStartWin" Content="开机自动启动本程序" Style="{StaticResource Check}"
                              Checked="OnStartWinChanged" Unchecked="OnStartWinChanged"/>
                    <CheckBox x:Name="ChkStartMin" Content="启动时最小化（关闭窗口后仍在后台运行）"
                              Style="{StaticResource Check}" Checked="OnStartMinChanged" Unchecked="OnStartMinChanged"/>
                </StackPanel>
            </Border>

            <!-- service -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="后台服务（开机重放设置）" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="TxtService" Text="检测中…" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,10" Foreground="{StaticResource TextMuted}"/>
                    <WrapPanel>
                        <Button Content="安装并启动服务" Style="{StaticResource BtnPrimary}" Click="OnInstallService"/>
                        <Button Content="停止并移除服务" Style="{StaticResource BtnDanger}" Margin="0" Click="OnRemoveService"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="服务在开机后自动重新下发功耗与电压。GPU 的功耗策略只存在于驱动内存中，重启后必然丢失，所以“重启后继续生效”只能靠服务重放。"/>
                </StackPanel>
            </Border>

            <!-- mVolt+ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="mVolt+ 路径" Style="{StaticResource CardTitle}"/>
                    <TextBox x:Name="TxtMvoltPath" Style="{StaticResource Input}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="浏览…" Style="{StaticResource Btn}" Click="OnBrowseMvolt"/>
                        <Button Content="自动搜索" Style="{StaticResource Btn}" Margin="0" Click="OnAutoFindMvolt"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="留空表示自动在本程序同目录、dist、以及用户目录中搜索 mVolt+.exe。电压写入由 mVolt+ 执行，本程序只负责保存与重放。"/>
                </StackPanel>
            </Border>

            <!-- compatibility mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="兼容模式" Style="{StaticResource CardTitle}"/>
                    <Button Content="切换到标准模式（移除驱动，供反作弊游戏使用）"
                            Style="{StaticResource BtnDanger}" HorizontalAlignment="Left" Margin="0"
                            Click="OnStandardMode"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="标准模式会恢复出厂设置、停止服务并移除内核驱动，以便运行要求开启 Secure Boot 的内核级反作弊游戏。设置会保留，切回解锁模式后自动重新应用。"/>
                </StackPanel>
            </Border>

            <!-- close -->
            <Button Content="关闭" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right"
                    MinWidth="100" Margin="0,4,0,0" Click="OnClose"/>

        </StackPanel>
    </ScrollViewer>
</Window>
